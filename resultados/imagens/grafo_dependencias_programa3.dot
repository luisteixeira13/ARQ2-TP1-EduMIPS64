digraph Dependencias {
  graph [rankdir=LR, bgcolor="white", fontname="DejaVu Sans", nodesep=0.45, ranksep=1.0,
         label="Programa 3 otimizado — laço Produto\nDependências e restrições de reordenação", labelloc=t, fontsize=19, fontcolor="#17324b", pad=0.35];
  node [shape=box, style="rounded,filled", color="#63809b", fillcolor="#eaf3fa", fontname="DejaVu Sans", fontsize=11, margin="0.17,0.13"];
  edge [fontname="DejaVu Sans", fontsize=10, arrowsize=0.7, color="#176f86", fontcolor="#176f86", penwidth=1.8];
  subgraph cluster_trecho {
     label="Iteração atual (I1–I8)";
     style="rounded"; color="#d7e1ec"; fontname="DejaVu Sans"; fontsize=13; fontcolor="#4e657c";
     I1 [label="I1 · LD R9, 0(R7)"];
     I2 [label="I2 · LD R10, 0(R8)"];
     I3 [label="I3 · DADDI R7, R7, 8", fillcolor="#fff6e6"];
     I4 [label="I4 · DADDI R8, R8, 16", fillcolor="#fff6e6"];
     I5 [label="I5 · DMUL R11, R9, R10"];
     I6 [label="I6 · DADDI R6, R6, 1"];
     I7 [label="I7 · DADD R12, R12, R11"];
     I8 [label="I8 · BNE R6, R15, Produto", fillcolor="#eef3ff"];
  }
  I1 -> I5 [label="RAW R9"];
  I2 -> I5 [label="RAW R10"];
  I5 -> I7 [label="RAW R11"];
  I6 -> I8 [label="RAW R6"];
  I1 -> I3 [color="#b77b2a", fontcolor="#a06a25", style=dotted, penwidth=1.7, label="WAR R7"];
  I2 -> I4 [color="#b77b2a", fontcolor="#a06a25", style=dotted, penwidth=1.7, label="WAR R8"];
  node [shape=box, style="rounded,dashed,filled", color="#a0a8b1", fillcolor="#f7f9fb"];
  N1 [label="Próxima iteração\nLD R9, 0(R7)"];
  N2 [label="Próxima iteração\nLD R10, 0(R8)"];
  N7 [label="Próxima iteração\nDADD R12, R12, R11"];
  I3 -> N1 [color="#64748b", fontcolor="#64748b", style=dashed, label="RAW R7"];
  I4 -> N2 [color="#64748b", fontcolor="#64748b", style=dashed, label="RAW R8"];
  I7 -> N7 [color="#64748b", fontcolor="#64748b", style=dashed, label="RAW R12"];
}
